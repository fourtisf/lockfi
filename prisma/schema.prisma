// Tidewell (formerly Balast) P1 — the indexer's database (§4).
//
// The schema sketch in §4 is followed field for field. Two things are added,
// and both exist to make §9's acceptance criterion reachable rather than
// aspirational:
//
//   swap_events / liquidity_events — the raw log rows, keyed (tx_hash,
//   log_index). §4 says "writes raw rows" and "upsert by (txHash, logIndex)";
//   these are those rows.
//
//   pool_fee_hourly is DERIVED from them by aggregation, never incremented.
//   That is the whole trick behind §9: an increment is order-dependent and a
//   replay double-counts, but re-aggregating a set of rows keyed by
//   (tx_hash, log_index) gives byte-identical output no matter how many times
//   the same logs arrive, in what order, or in what range sizes.
//
// Money is Decimal, never Float. A USD figure that drifts by a rounding error
// every pass would make §9 unprovable and the displayed numbers untrustworthy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- discovery --

model Token {
  address      String    @id
  symbol       String
  name         String
  decimals     Int       @default(18)
  /// `totalSupply()`, read from the token contract.
  ///
  /// This is TOTAL supply, not circulating: locked, vested and treasury-held
  /// tokens are all in it, and none of that is distinguishable on chain. So
  /// the figure it produces is fully diluted value, and it is labelled as
  /// such rather than called market cap (§7). Null until it has been read.
  totalSupply  Decimal?  @map("total_supply") @db.Decimal(78, 0)
  /// When the supply was last read. Mintable tokens change, so it is
  /// refreshed on a cadence rather than once at discovery.
  supplyReadAt DateTime? @map("supply_read_at")
  logoUrl      String?   @map("logo_url")
  /// Where logoUrl came from: "list" (config/tokens.json or TOKEN_LIST_URL),
  /// "geckoterminal", "dexscreener" or "blockscout". Kept so a wrong logo can
  /// be traced to the source that supplied it. Only the image URL is ever
  /// taken from these: §4 allows logos from outside, and numbers from nowhere.
  logoSource   String?   @map("logo_source")
  /// When to look this token up in the logo sources again. Null means never
  /// looked; a token with no logo anywhere is retried a day later, one whose
  /// lookup failed (rate limit, timeout) half an hour later.
  logoRetryAt  DateTime? @map("logo_retry_at")
  /// Brand colour. Metadata, not a design decision (§5).
  logoColor    String?   @map("logo_color")
  /// Pons, Bags, Bottom.fun — set when the token came from a launchpad (§4).
  launchpad    String?
  firstSeen    DateTime  @map("first_seen")

  poolsAsToken0 Pool[] @relation("token0")
  storedLogo    TokenLogo?
  poolsAsToken1 Pool[] @relation("token1")

  @@index([symbol])
  @@map("tokens")
}

model Pool {
  id            String   @id
  address       String
  chainId       Int      @map("chain_id")
  token0        String
  token1        String
  feeTier       Int      @map("fee_tier")
  tickSpacing   Int      @map("tick_spacing")
  hooks         String?
  /// "v4" or "v3" — some older pools on this chain are v3 (§4).
  protocol      String
  createdBlock  BigInt   @map("created_block")
  /// The price and tick the pool was initialised at.
  ///
  /// An immutable fact from the Initialize log, and the only price a pool has
  /// before its first swap. Without it stored, a ModifyLiquidity arriving in
  /// a later batch for a pool that has not traded yet cannot be valued — and
  /// the ingest step could only throw, which halted the indexer completely.
  initSqrtPrice Decimal? @map("init_sqrt_price_x96") @db.Decimal(78, 0)
  initTick      Int?     @map("init_tick")
  /// Set from the block timestamp of Initialize, so pool age is chain time.
  createdAt     DateTime @map("created_at")
  /// Pre-graduation launchpad liquidity is listed but NOT stakeable (§4).
  stakeable     Boolean  @default(true)

  tokenA Token @relation("token0", fields: [token0], references: [address])
  tokenB Token @relation("token1", fields: [token1], references: [address])

  swaps            SwapEvent[]
  liquidity        LiquidityEvent[]
  feeHours         PoolFeeHourly[]
  state            PoolState?
  vault            Vault?
  positions        Position[]
  poolFlowHourlies PoolFlowHourly[]

  @@unique([address, chainId])
  @@index([protocol])
  @@map("pools")
}

// -------------------------------------------------------------- raw events --
// Upserted by (tx_hash, log_index). Re-scanning the last 32 blocks every pass
// (§4.1) therefore costs nothing and changes nothing.

model SwapEvent {
  txHash    String   @map("tx_hash")
  logIndex  Int      @map("log_index")
  poolId    String   @map("pool_id")
  blockNum  BigInt   @map("block_num")
  blockTime DateTime @map("block_time")
  /// Signed, in token units as emitted. amount0 < 0 means token0 left the pool.
  amount0   Decimal  @db.Decimal(78, 0)
  amount1   Decimal  @db.Decimal(78, 0)
  sqrtPrice Decimal  @map("sqrt_price_x96") @db.Decimal(78, 0)
  liquidity Decimal  @db.Decimal(78, 0)
  tick      Int
  /// Fee charged on this swap, in the input token's smallest unit.
  feeAmount Decimal  @map("fee_amount") @db.Decimal(78, 0)
  /// Which side the fee was taken in: 0 or 1.
  feeToken  Int      @map("fee_token")
  sender    String

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([txHash, logIndex])
  @@index([poolId, blockTime])
  @@index([blockNum])
  /// For "the pool's latest state": a DISTINCT ON (pool_id) ordered by
  /// position. Without it that query is a sort of the whole table on every
  /// pass, which is the difference between a second and a minute once the
  /// chain has a few million swaps in it.
  @@index([poolId, blockNum, logIndex])
  @@map("swap_events")
}

model LiquidityEvent {
  txHash         String   @map("tx_hash")
  logIndex       Int      @map("log_index")
  poolId         String   @map("pool_id")
  blockNum       BigInt   @map("block_num")
  blockTime      DateTime @map("block_time")
  tickLower      Int      @map("tick_lower")
  tickUpper      Int      @map("tick_upper")
  /// Signed: negative is a burn. v3 Mint/Burn are normalised to this.
  liquidityDelta Decimal  @map("liquidity_delta") @db.Decimal(78, 0)
  amount0        Decimal  @db.Decimal(78, 0)
  amount1        Decimal  @db.Decimal(78, 0)
  owner          String

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([txHash, logIndex])
  @@index([poolId, blockTime])
  @@index([blockNum])
  @@map("liquidity_events")
}

/// One row per contract the poller follows, so a restart resumes rather than
/// rescanning the chain.
model IndexerCursor {
  contract         String   @id
  lastIndexedBlock BigInt   @map("last_indexed_block")
  /// Block time of that block: the honest input to the lag shown in the top bar (§7).
  lastIndexedAt    DateTime @map("last_indexed_at")
  updatedAt        DateTime @map("updated_at")

  @@map("indexer_cursors")
}

// ------------------------------------------------------------- aggregations --

/// Derived from swap_events by aggregation. Never incremented — see the header.
model PoolFeeHourly {
  poolId     String   @map("pool_id")
  /// Truncated to the hour, UTC.
  hour       DateTime
  feesToken0 Decimal  @map("fees_token0") @db.Decimal(78, 0)
  feesToken1 Decimal  @map("fees_token1") @db.Decimal(78, 0)
  feesUsd    Decimal  @map("fees_usd") @db.Decimal(38, 18)
  volumeUsd  Decimal  @map("volume_usd") @db.Decimal(38, 18)
  swaps      Int

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([poolId, hour])
  @@index([hour])
  @@map("pool_fee_hourly")
}

/**
 * Signed token flow per pool per hour, derived from swap and liquidity events.
 * A pool's reserves are the sum of every signed amount it ever emitted — on v4
 * that is the only way to get them, since the PoolManager holds every pool's
 * tokens in one balance. Summing the raw event tables directly is correct and
 * completely unscalable: it is a full scan of both tables, for every pool, on
 * every pass.
 * So the sum is staged. This table is rebuilt only for the hours a pass
 * touched, and reserves are then a sum over it — 24 rows a day per pool
 * instead of every swap ever. It stays an aggregation rather than a running
 * total, so it replays as cleanly as pool_fee_hourly does (§9).
 */
model PoolFlowHourly {
  poolId String   @map("pool_id")
  hour   DateTime
  delta0 Decimal  @db.Decimal(78, 0)
  delta1 Decimal  @db.Decimal(78, 0)

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([poolId, hour])
  @@map("pool_flow_hourly")
}

/**
 * WETH in USD, per hour, from the one WETH/USDG anchor pool (§4.3).
 * Materialised for the same reason as the table above: every fee in every
 * pool is valued through this series, and recomputing it from the anchor's
 * whole swap history on each pass made the fee rebuild quadratic in the
 * number of hours indexed.
 * An hour with no anchor swap has no row. Readers carry the last price
 * forward rather than treating the gap as zero — a quiet hour in the anchor
 * pool is not WETH becoming worthless.
 */
/// Logos we fetched once and serve from our own origin at /api/logo/:address.
///
/// Launchpad tokens declare their image on chain — Pons in logo(), Doppler in
/// tokenURI()'s metadata — and nearly always on IPFS, which no public gateway
/// serves reliably to browsers any more (ipfs.io answers 429 and is moving to
/// a service worker). So the indexer fetches the image once, checks it is an
/// image by its bytes, shrinks it to a badge, and keeps it here.
model TokenLogo {
  address     String   @id
  contentType String   @map("content_type")
  bytes       Bytes
  /// Where it came from, for tracing a wrong logo back to its source.
  origin      String
  fetchedAt   DateTime @map("fetched_at")

  token Token @relation(fields: [address], references: [address], onDelete: Cascade)

  @@map("token_logos")
}

model WethUsdHourly {
  hour    DateTime @id
  wethUsd Decimal  @map("weth_usd") @db.Decimal(38, 18)

  @@map("weth_usd_hourly")
}

/// Latest snapshot per pool. Overwritten, not appended.
model PoolState {
  poolId    String   @id @map("pool_id")
  tvlUsd    Decimal  @map("tvl_usd") @db.Decimal(38, 18)
  priceUsd  Decimal  @map("price_usd") @db.Decimal(38, 18)
  mcUsd     Decimal  @map("mc_usd") @db.Decimal(38, 18)
  /// sqrtPriceX96 at the last swap: the input to every derived price (§4.3).
  sqrtPrice Decimal  @map("sqrt_price_x96") @db.Decimal(78, 0)
  tick      Int
  liquidity Decimal  @db.Decimal(78, 0)
  updatedAt DateTime @map("updated_at")

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@map("pool_state")
}

// ------------------------------------------------------------------ product --

/// One row per deployed vault, REBUILT from its events (indexer/contracts.ts),
/// never incremented (§14).
///
/// The vault credits fees per share the moment it collects them, and any
/// deposit, withdraw, claim or poke collects first: there is no harvest, no
/// stream and no keeper. So there is no reward rate or harvest time here —
/// only what was staked, what was collected, and what was paid out. Token
/// amounts are raw units of the pool's currency0 and currency1.
model Vault {
  poolId         String    @id @map("pool_id")
  address        String    @unique
  /// Liquidity units staked: Deposited minus Withdrawn.
  totalStaked    Decimal   @map("total_staked") @db.Decimal(78, 0)
  /// The vault's full-range liquidity valued at the pool's latest price, the
  /// same way pool TVL is (aggregate.ts). Zero while the pool is unpriced.
  totalStakedUsd Decimal   @map("total_staked_usd") @db.Decimal(38, 18)
  stakers        Int
  protocolFeeBps Int       @map("protocol_fee_bps")
  /// Whether NEW deposits are open (the latest DepositsOpenSet; open at
  /// deployment). Withdraw and claim are never gated.
  depositsOpen   Boolean   @default(true) @map("deposits_open")
  /// Every fee the position collected, before the protocol's cut (Σ FeesCollected).
  feesCollected0 Decimal   @map("fees_collected0") @db.Decimal(78, 0)
  feesCollected1 Decimal   @map("fees_collected1") @db.Decimal(78, 0)
  /// The protocol's share of those, set aside at collection.
  protocolCut0   Decimal   @map("protocol_cut0") @db.Decimal(78, 0)
  protocolCut1   Decimal   @map("protocol_cut1") @db.Decimal(78, 0)
  /// What stakers have claimed (Σ Claimed).
  claimed0       Decimal   @map("claimed0") @db.Decimal(78, 0)
  claimed1       Decimal   @map("claimed1") @db.Decimal(78, 0)
  /// What has been paid to the treasury (Σ ProtocolFeesPaid).
  protocolPaid0  Decimal   @map("protocol_paid0") @db.Decimal(78, 0)
  protocolPaid1  Decimal   @map("protocol_paid1") @db.Decimal(78, 0)
  /// Block time of the first Deposited event.
  stakedSince    DateTime? @map("staked_since")
  /// Block time of the latest FeesCollected: fees earned since then are in
  /// the position, uncredited until the next deposit, withdraw, claim or poke.
  lastCollectedAt DateTime? @map("last_collected_at")
  /// Chain time of the last block whose vault events were read.
  updatedAt      DateTime  @map("updated_at")

  pool   Pool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  stakes Stake[]

  @@map("vaults")
}

/// Every swap in a vault's pool over the trailing eight days, read straight
/// from the chain by the vault watcher (server/keeper/vault-watch.ts),
/// independent of the pool indexer's cursor. Signed as Uniswap v4 emits
/// them: negative is what the swapper paid INTO the pool.
model VaultSwap {
  poolId        String   @map("pool_id")
  blockNum      BigInt   @map("block_num")
  logIndex      Int      @map("log_index")
  txHash        String   @map("tx_hash")
  /// Interpolated between the timestamps of the read range's two ends.
  blockTime     DateTime @map("block_time")
  amount0       Decimal  @db.Decimal(78, 0)
  amount1       Decimal  @db.Decimal(78, 0)
  sqrtPrice     Decimal  @map("sqrt_price_x96") @db.Decimal(78, 0)
  /// The pool's in-range liquidity after the swap.
  liquidity     Decimal  @db.Decimal(78, 0)
  tick          Int
  /// The whole fee charged, Uniswap's protocol fee included, in pips.
  swapFeePips   Int      @map("swap_fee_pips")
  /// The LPs' part of the fee, in the input token's smallest unit.
  lpFee         Decimal  @map("lp_fee") @db.Decimal(78, 0)
  /// Which side came in: 0 or 1; -1 when the swap cannot be attributed.
  feeToken      Int      @map("fee_token") @db.SmallInt
  amountIn      Decimal  @map("amount_in") @db.Decimal(78, 0)
  /// lp_fee x 2^128 / liquidity: this swap's step of the pool's fee growth,
  /// which is what a full-range position earns per unit of liquidity.
  feeGrowthX128 Decimal  @map("fee_growth_x128") @db.Decimal(78, 0)

  @@id([poolId, blockNum, logIndex])
  @@index([poolId, blockTime])
  @@map("vault_swaps")
}

/// A vault's pool as the chain stood at the last block the watcher read.
model VaultPoolState {
  poolId           String   @id @map("pool_id")
  vaultAddress     String   @map("vault_address")
  currency0        String
  currency1        String
  symbol0          String
  symbol1          String
  decimals0        Int
  decimals1        Int
  /// The pool's LP fee from its key, in pips.
  lpFeePips        Int      @map("lp_fee_pips")
  blockNum         BigInt   @map("block_num")
  blockTime        DateTime @map("block_time")
  sqrtPrice        Decimal  @map("sqrt_price_x96") @db.Decimal(78, 0)
  tick             Int
  liquidity        Decimal  @db.Decimal(78, 0)
  /// The vault's own full-range liquidity: its totalSupply.
  vaultLiquidity   Decimal  @map("vault_liquidity") @db.Decimal(78, 0)
  feeGrowth0X128   Decimal  @map("fee_growth0_x128") @db.Decimal(78, 0)
  feeGrowth1X128   Decimal  @map("fee_growth1_x128") @db.Decimal(78, 0)
  /// Where the swap history in vault_swaps begins.
  historyFromBlock BigInt   @map("history_from_block")
  historyFromTime  DateTime @map("history_from_time")
  updatedAt        DateTime @map("updated_at")

  @@map("vault_pool_state")
}

/// A wallet's shares in one vault and what it has claimed, rebuilt from the
/// vault's events. A wallet that withdrew but claimed keeps its row.
model Stake {
  wallet    String
  vaultId   String   @map("vault_id")
  shares    Decimal  @db.Decimal(78, 0)
  /// Σ Claimed, in raw units of the pool's currency0 and currency1.
  claimed0  Decimal  @map("claimed0") @db.Decimal(78, 0)
  claimed1  Decimal  @map("claimed1") @db.Decimal(78, 0)
  updatedAt DateTime @map("updated_at")

  vault Vault @relation(fields: [vaultId], references: [poolId], onDelete: Cascade)

  @@id([wallet, vaultId])
  @@index([wallet])
  @@map("stakes")
}

model Position {
  tokenId   String   @id @map("token_id")
  wallet    String
  poolId    String   @map("pool_id")
  tickLower Int      @map("tick_lower")
  tickUpper Int      @map("tick_upper")
  liquidity Decimal  @db.Decimal(78, 0)
  /// spot / curve / bidask — the frontend weight generator used at mint (§3.2).
  shape     String?
  status    String
  updatedAt DateTime @map("updated_at")

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([wallet])
  @@map("positions")
}

/// Raw events from Tidewell's own contracts — the vaults, the router factory
/// and the routers it created — keyed by log coordinates like every raw table,
/// so re-reading a range changes nothing. `vaults` and `stakes` are REBUILT
/// from these rows, never incremented (§14).
model ContractEvent {
  txHash    String   @map("tx_hash")
  logIndex  Int      @map("log_index")
  /// The emitting contract, lowercase.
  contract  String
  /// vault | router | router-factory
  source    String
  blockNum  BigInt   @map("block_num")
  blockTime DateTime @map("block_time")
  /// The event name: Deposited, FeesCollected, Claimed, RouterCreated, Observed, ...
  kind      String
  /// The address the event is about: a vault's share owner or claimant, a
  /// treasury, a router's keeper, a created router. Null where there is none.
  account   String?
  /// Every argument. uints as decimal strings, addresses lowercase.
  args      Json

  @@id([txHash, logIndex])
  @@index([contract, kind, blockNum])
  @@map("contract_events")
}

/// Every keeper attempt on a router: a poke that failed or was refused, or a
/// route (§8, P3; P4). A run that was skipped says why, so a keeper that is up
/// but not routing is visible from /api/health rather than only in a log
/// nobody reads. Vaults need no keeper (see Vault).
model KeeperRun {
  id              String   @id @default(uuid())
  /// The router, lowercase.
  contract        String
  /// poke | route
  kind            String
  startedAt       DateTime @map("started_at")
  finishedAt      DateTime @map("finished_at")
  /// ok | reverted | skipped | error. `reverted` always means a transaction
  /// was mined and reverted; a revert caught in simulation sent nothing and
  /// is `skipped`.
  status          String
  txHash          String?  @map("tx_hash")
  /// The address that signed, or would have.
  signer          String?
  reason          String?
  /// The numbers behind the decision: observation age, a route's amounts
  /// from its Routed event. uints as decimal strings.
  details         Json?

  @@index([contract, startedAt])
  @@map("keeper_runs")
}

model RouterConfig {
  id             String   @id
  token          String
  feeSource      String   @map("fee_source")
  /// CADENCE or MILESTONE (§3.4).
  mode           String
  cadenceS       Int?     @map("cadence_s")
  milestonesJson Json?    @map("milestones_json")
  paused         Boolean  @default(false)
  updatedAt      DateTime @map("updated_at")

  routes RouterRoute[]

  @@index([token])
  @@map("router_configs")
}

model RouterRoute {
  id             String   @id @default(uuid())
  configId       String   @map("config_id")
  txHash         String   @unique @map("tx_hash")
  wethIn         Decimal  @map("weth_in") @db.Decimal(78, 0)
  liquidityAdded Decimal  @map("liquidity_added") @db.Decimal(78, 0)
  /// The 30-minute TWAP it routed at, never spot (§3.4).
  twapPrice      Decimal  @map("twap_price") @db.Decimal(38, 18)
  routedAt       DateTime @map("routed_at")

  config RouterConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId, routedAt])
  @@map("router_routes")
}
