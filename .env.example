# ---------------------------------------------------------------- frontend --

# Which DataProvider the app reads from (§4).
#   sim   — the P0 simulator: the prototype's generated pools, vaults and positions
#   live  — the P1 indexer, through the API below
DATA_SOURCE=sim

# Where the browser reaches the API. Empty means same origin, which is what
# nginx serves in production; set it only for `next dev` against a remote API.
# NEXT_PUBLIC_API_BASE=

# ------------------------------------------------------------------- P1 db --

DATABASE_URL="postgresql://balast:CHANGEME@127.0.0.1:5432/balast?schema=public"

# Optional. Without it the indexer→API tick bus is in-process, which is correct
# for one API instance on one box and silently wrong for two.
# REDIS_URL="redis://127.0.0.1:6379"

# ---------------------------------------------------------------- P1 chain --

# Robinhood Chain, chainId 4663 (§2). Tried in order; the first that answers
# is used and kept until it fails. These are the public endpoints from the
# chain registry, and they are enough: every transaction a person signs goes
# through their own wallet's connection, not this list. A paid endpoint only
# makes the backfill faster; put it first if you ever add one.
#
# RPC_START picks which endpoint a process tries first (an index, default 0).
# ecosystem.config.js starts the API and the logo process on different free
# endpoints from the indexer, because free endpoints rate-limit per IP.
RPC_URLS="https://rpc.mainnet.chain.robinhood.com,https://robinhood-rpc.publicnode.com,https://rpc.arrowrpc.com,https://rpc.ordofi.network"

# The portfolio asks the chain which positions a wallet holds — v3 enumerated
# on its position manager, v4 confirmed id by id, plus a background scan for
# v4 positions minted after the indexer's last one — through the endpoints
# above, each read bounded so a slow node never hangs the page. "false" turns
# it off, and the page then lists only the indexer's (possibly weeks-old)
# record, unchecked.
PORTFOLIO_CHAIN=true

# Optional, default true. Reads each listed v3 pool's reserves from the chain
# once a minute (two balanceOf calls per pool, one multicall), so the fee yield
# divides today's fees by today's liquidity rather than the indexer's (§31).
# false: the yield falls back to the indexer's figure, labelled with its age.
LIVE_RESERVES=true

# Optional. Pins the USD anchor.
#
# USDG is the day-one stablecoin on this chain, not USDC (§2), and the
# WETH/USDG pool is the site's single USD anchor (§4.3). Leave this UNSET and
# the indexer finds it: it already reads every token's symbol off-chain while
# discovering pools, so it looks for the one called USDG trading against WETH.
# `/api/health` reports which token it chose and why.
#
# Set it only to override that — to pin a specific token when two claim the
# same symbol, for instance. A malformed value is refused rather than quietly
# discovered past, because pricing the site off the wrong token cannot be
# detected from anywhere downstream.
USDG_ADDRESS=

# Block to start from. Leaving it at 0 scans the chain from genesis, which on
# ~100ms blocks (§2) is a very long first sync. Set it to the PoolManager's
# deployment block.
START_BLOCK=0

# Blocks per eth_getLogs call, and the FLOOR for the adaptive range — the
# width used once the indexer is following head, where a narrow window keeps
# latency low.
INDEXER_BLOCK_RANGE=2000

# Ceiling while backfilling.
#
# This chain is 62 million blocks deep and almost all of it is empty. At the
# floor above that is some thirty thousand round trips — about thirty-four
# hours — before reaching anything worth indexing, so empty ranges widen
# toward this and busy ones narrow back.
#
# It only has to be optimistic, not correct: endpoints cap eth_getLogs
# differently and none announce it, so the poller learns the real limit the
# first time one refuses, and stays under it from then on.
INDEXER_MAX_BLOCK_RANGE=50000

# Windows fetched at once per pass.
#
# Most of a pass's time does not scale with the window — the anchor query,
# the aggregate rebuild, the cursor write — so several windows a pass divide
# that cost by as many. The poller halves this itself on a rate limit or a
# timeout and climbs back after a stretch of clean passes.
INDEXER_CONCURRENCY=6
# Milliseconds between passes once caught up to head.
INDEXER_POLL_MS=1000

# How many hours of the chain's HEAD a second reader keeps, beside the backfill.
# The backfill reads in order from START_BLOCK because reserves are the sum of a
# pool's whole history; on sixty million blocks that costs days, and for all of
# them the board's volume is a day two months old. This window is read from the
# other end into a table nothing else touches, and answers "what traded today"
# for every pool. 24 matches the board's figures; 0 turns it off.
HEAD_WINDOW_HOURS=24
# Chain milliseconds per block, for turning those hours into a block count.
CHAIN_BLOCK_MS=100

# Hooks verified safe to add liquidity through. A pool with no hook is
# stakeable; a pool with a hook is offered only if the hook is listed here,
# because a hook can refuse liquidity or take most of every trade as its fee
# (one on this chain takes about 98%), and nothing in the log stream says so.
STAKEABLE_HOOKS=

# Launchpad hook addresses (§4). A pool whose hook is one of these is
# pre-graduation: listed, but never offered as a stake. Empty means every pool
# is treated as stakeable — fine for a listing, WRONG for a vault, so P2 must
# not deploy against pools discovered while this was blank.
#   LAUNCHPAD_HOOKS="Pons:0x…,Bags:0x…,Bottom.fun:0x…"
LAUNCHPAD_HOOKS=

# The Uniswap v3 factory. §4 says some older pools on this chain are v3, and
# a v3 pool is only discoverable through the factory's PoolCreated event —
# without this, v3 pools are only the ones hand-listed below, which silently
# omits every pool nobody thought to list. Find it on the explorer.
V3_FACTORY=

# Extra v3 pools to follow, for one whose PoolCreated predates START_BLOCK.
# Pools found through the factory are followed automatically and reloaded
# from the database on restart, so this is normally empty.
#   V3_POOLS="0x…,0x…"
V3_POOLS=

# Token list, for logos only.
#
# §4 allows logos and token metadata from external sources and numbers from
# none. This is read for `logoURI` and nothing else — decimals stay an
# on-chain read, because they are an input to every price.
#
# Accepts a local path as well as a URL. Robinhood Chain has no public token
# list, so `config/tokens.json` in this repository is where real logos go
# until one exists; add entries there and the indexer picks them up on its
# next pass. Switching to a public list later is this one line.
#
# Unset, every token still gets a mark derived from its own address — unique,
# stable, and legible — and not one number on the site differs.
TOKEN_LIST_URL=config/tokens.json

# Per-token logo lookups, for everything the list does not cover. Each source
# reads ONE image URL per token and nothing else (§4: logos from outside,
# numbers never). One token every LOGO_LOOKUP_MS, listed tokens first, and a
# token nobody knows is asked about again only after a week. `none` disables.
#   coingecko      keyless; COINGECKO_API_KEY (demo key) raises the rate
#   dexscreener    keyless; the source most likely to know a launchpad token
#   coinmarketcap  needs CMC_API_KEY, otherwise disables itself
LOGO_SOURCES=explorer,tickers,onchain,pons,geckoterminal,dexscreener,coingecko,coinmarketcap
# A launchpad's own site, asked for its token pages: {base}/{address}.
PONS_LAUNCHPAD_URL=https://www.ponsfamily.com/launchpad
# Gateway for ipfs:// metadata a token contract points at (the onchain source).
IPFS_GATEWAY=https://ipfs.io/ipfs/
# GeckoTerminal's id for this chain is set once, under "the live market" below;
# the logo source reads the same variable.
LOGO_LOOKUP_MS=6000
# COINGECKO_API_KEY=
# CMC_API_KEY=

# Minimum fully diluted value, in USD, for a pool's token to appear on the
# boards. A young chain's PoolManager is mostly dust; below this a pool is
# still indexed and counted, just not listed. The ether/USDG market is always
# listed. 0 lists everything.
LISTING_MIN_FDV_USD=1000000
# Minimum liquidity, in USD, for a pool to be listed; applied only when the
# liquidity is known. The board ranks by market cap, and a price from a pool
# with a few dollars in it supports no market cap at all. 0 lists everything.
LISTING_MIN_LIQUIDITY_USD=10000
# The dollars that have to be BEHIND a row: either sitting in the pool on the
# quote side (ether or USDG, the only side priced outside the pool), or traded
# through it during the yield window. The floor above values BOTH sides, and
# the token side's price comes from the pool's own ratio — so a launchpad pool
# holding a whole supply reports a liquidity equal to that token's FDV with
# dust actually in it, and cleared any both-sides floor. 0 lists everything.
LISTING_MIN_BACKING_USD=2000
# Whether stablecoins get rows of their own on the board. A dollar is not a
# project, and ranked by market cap it would sit above every one of them.
LISTING_STABLECOINS=false

# ------------------------------------------------------------------ P1 api --

API_PORT=3001
API_HOST=127.0.0.1
# §4.4: push on real events, debounced to about a second per pool.
STREAM_DEBOUNCE_MS=1000

# Requests per window per client. Generous: the front end polls every 20s
# behind the websocket and a dozen tabs behind one NAT must not be throttled.
# This stops a loop hammering the snapshot query, not users.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ----------------------------------------------------------------- testing --

# The §9 acceptance test truncates this database on every run, so the name
# must contain "balast_test" or the suite refuses to start.
# TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/balast_test?schema=public"

# --- Token logos: the chain's own explorer -----------------------------------
# Blockscout keeps an icon per token and serves it from /api/v2/tokens/{addr}.
# The default is the explorer the ethereum-lists/chains registry names for
# chainId 4663. It is asked before the aggregators, because it is native to
# this chain rather than one that may or may not have heard of it.
EXPLORER_API_URL=https://robinhoodchain.blockscout.com

# --- Live market figures -----------------------------------------------------
# The owner's exception to §4: the row's volume, its buys and sells, the 24h
# change, the market cap and (where the chain's own events cannot reconstruct
# it) the liquidity come from an aggregator, labelled, with the chain's figure
# as the fallback. Every figure is the TOKEN's, summed over its pairs on this
# chain — a token here has several pools, and reading the day off one of them
# is what put $17.9K of volume on NVDA.
#
# Two sources, asked in that order. DexScreener quoted 32 of the board's 76
# tokens; GeckoTerminal is asked for the rest. A refusal backs off the source
# that refused, not the board.
#
# DEXSCREENER_CHAIN is DexScreener's id for Robinhood Chain, `robinhood` (the
# default); an empty value accepts every chain's pairs and /api/health lists
# the ids it saw. GECKOTERMINAL_NETWORK is its id for this chain; unset, it is
# discovered from GeckoTerminal's own network list by name, and the probe
# prints what it found — worth pinning once it has.
#
# `npm run market:probe -- <ticker or address>` asks both and prints every pair
# behind the sum, so a figure on a row can be traced to its source; and
# /api/health's `market.unknownTokens` names the board's tokens no source
# placed, which is the difference between "nobody lists these" and "we are
# not asking".
DEXSCREENER_MARKET=true
DEXSCREENER_CHAIN=robinhood
DEXSCREENER_REFRESH_MS=30000
# GeckoTerminal's id for this chain is `robinhood` (the default, read off the
# box). Leave it alone: unset in the file is NOT the same as absent — an empty
# value restores discovery, which walks GeckoTerminal's network list up to
# twenty requests per process and earns a 429 on its keyless tier.
GECKOTERMINAL_NETWORK=robinhood

# --- The token ---------------------------------------------------------------
# The contract address ($BLST) and the X link are constants in lib/site.ts,
# not variables: a stale value here must never reach the page.
# WalletConnect (phones, by QR): a free project id from https://cloud.reown.com.
# Without it the dialog lists browser wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Ask LockFi AI -------------------------------------------------------------
# The assistant in the Stake drawer, the builder and /learn (server/api/ask.ts).
# Off, and hidden on the page, until AI_API_KEY is set. Any OpenAI-compatible
# endpoint works; the default is OpenRouter (openrouter.ai/keys, a `sk-or-v1-…`
# key; credit at openrouter.ai/credits) with Claude Haiku 4.5.
# For Dualyne's gateway instead: AI_BASE_URL=https://api.dualyne.com/v1,
# AI_MODEL=claude-swift and a `dly_live_…` key.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-haiku-4.5
# About 150 words per answer; questions per client per minute; answers per UTC day, everyone together.
AI_MAX_TOKENS=450
AI_PER_MINUTE=6
AI_DAILY_LIMIT=1000

# --- Router keeper (§48) --------------------------------------------------------
# The lockfi-keeper process routes each LockFi Router when it is due. It waits
# quietly until the factory is deployed (ROUTER_FACTORY in lib/chain.ts) and
# this key is set. Use a FRESH wallet that holds only a little ETH for gas: the
# keeper only triggers routes and never receives funds. The factory must name
# this wallet's address as its keeper.
KEEPER_PRIVATE_KEY=
# Skip a route with less new ETH than this; the least under the quote to accept;
# how far the price may be from its 30-minute average before the keeper waits.
KEEPER_MIN_ROUTE_ETH=0.002
KEEPER_SLIPPAGE_BPS=100
KEEPER_MAX_DEVIATION_BPS=300
