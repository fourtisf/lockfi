{
  "name": "balast",
  "version": "0.1.0",
  "private": true,
  "description": "Balast \u2014 liquidity layer for Robinhood Chain. P0: shell and simulated data.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api": "tsx server/api/main.ts",
    "indexer": "tsx server/indexer/main.ts",
    "doctor": "bash deploy/doctor.sh",
    "verify:chain": "tsx server/scripts/verify-chain.ts",
    "find:tokens": "tsx server/scripts/find-tokens.ts",
    "tokens:indexed": "tsx server/scripts/indexed-tokens.ts",
    "logos:probe": "tsx server/scripts/probe-logos.ts",
    "logos:status": "tsx server/scripts/logo-status.ts",
    "market:probe": "tsx server/scripts/market-probe.ts",
    "check:lp": "tsx server/scripts/lp-local.ts",
    "check:router": "tsx server/scripts/router-local.ts",
    "router:compile": "node scripts/compile-router.mjs",
    "keeper": "tsx server/keeper/main.ts",
    "logos": "tsx server/logos/main.ts",
    "aggregates:rebuild": "tsx server/scripts/force-rebuild.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "brand": "python3 scripts/build-brand.py && node scripts/build-brand-png.mjs",
    "postinstall": "prisma generate",
    "brand:social": "node scripts/build-lockfi-social.mjs",
    "brand:social:router": "node scripts/build-lockfi-social.mjs router",
    "brand:social:balast": "node scripts/render-social.mjs",
    "brand:premium": "tsx scripts/build-premium-banners.ts && node scripts/render-social.mjs p0 p1",
    "brand:shapes": "tsx scripts/build-shape-banners.ts && node scripts/render-social.mjs 08- 09- 10- 11-",
    "brand:journal": "python3 scripts/build-brand-journal.py && node scripts/build-brand-journal-png.mjs",
    "brand:lockfi": "node scripts/build-brand-lockfi.mjs",
    "brand:ad": "node scripts/build-lockfi-ad.mjs",
    "brand:ad:ai": "node scripts/build-lockfi-ai-ad.mjs",
    "brand:ad:portfolio": "node scripts/build-lockfi-portfolio-ai-ad.mjs",
    "brand:ad:token": "node scripts/build-lockfi-token-ad.mjs",
    "brand:ad:router": "node scripts/build-lockfi-router-ad.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@prisma/client": "^6.19.3",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "fastify": "^5.12.4",
    "ioredis": "^6.0.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.56.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "20.14.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@uniswap/sdk-core": "^7.19.2",
    "@uniswap/v4-sdk": "^2.3.3",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "5.6.3",
    "vitest": "^2.1.8"
  }
}
